import pandas as pd

def expand_stages(df, number_of_stages):
    expanded_rows = []

    for _, row in df.iterrows():
        tag = row.get("Tag_name")
        formula = row.get("PI_formula")
        
        if isinstance(tag, str) and "stage_A" in tag:
            for i in range(1, number_of_stages + 1):
                new_row = row.copy()
                
                # Replace in Tag_name
                new_row["Tag_name"] = tag.replace("stage_A", f"stage_{i}")
                
                # Replace in PI_formula (if exists and not null)
                if isinstance(formula, str):
                    new_row["PI_formula"] = formula.replace("stage_A", f"stage_{i}")
                
                expanded_rows.append(new_row)
        else:
            expanded_rows.append(row)

    return pd.DataFrame(expanded_rows).reset_index(drop=True)
