import plotly.express as px
from ipywidgets import interact, SelectMultiple, Dropdown

def plot_chart(x_col, y_cols):
    if len(y_cols) == 0:
        return
    
    fig = px.line(df, x=x_col, y=list(y_cols))
    fig.show()

interact(
    plot_chart,
    x_col=Dropdown(options=df.columns, description='X-axis'),
    y_cols=SelectMultiple(options=df.columns, description='Y-axis')
)
