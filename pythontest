import pandas as pd

def expand_stages(df, col_name, number_of_stages):
    expanded_rows = []

    for _, row in df.iterrows():
        tag = row[col_name]
        
        if isinstance(tag, str) and "stage_A" in tag:
            # replicate for each stage
            for i in range(1, number_of_stages + 1):
                new_row = row.copy()
                new_row[col_name] = tag.replace("stage_A", f"stage_{i}")
                expanded_rows.append(new_row)
        else:
            # keep as is (only once)
            expanded_rows.append(row)

    return pd.DataFrame(expanded_rows).reset_index(drop=True)

