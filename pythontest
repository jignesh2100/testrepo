import pandas as pd

def fmm_to_dataframe(ws):
    # Find last column (based on row 3)
    last_col = ws.range((3, ws.cells.last_cell.column)).end("left").column

    data = []

    for col in range(3, last_col + 1):  # start from column C
        tag_type = ws.cells(3, col).value
        pi_sensor = ws.cells(4, col).value
        tag_name = ws.cells(5, col).value

        # Skip empty columns
        if not tag_name:
            continue

        data.append({
            "Tag Type": tag_type,
            "PI Sensor": pi_sensor,
            "Tag Generic Name": tag_name
        })

    df = pd.DataFrame(data)

    return df
