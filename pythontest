import xlwings as xw
import re

def replace_stage_text(ws, present_stage):
    # Read full used range
    rng = ws.used_range
    data = rng.value

    def transform(text):
        if not isinstance(text, str):
            return text
        
        # Pattern: Stage A, Stage A+1, Stage A-1
        pattern = r"Stage A([+-]\d+)?"
        
        def repl(match):
            offset = match.group(1)
            
            if offset:
                stage_num = present_stage + int(offset)
            else:
                stage_num = present_stage
            
            return f"Stage {stage_num}"
        
        return re.sub(pattern, repl, text)

    # Apply transformation
    new_data = [
        [transform(cell) for cell in row]
        for row in data
    ]

    # Write back
    rng.value = new_data
