sheet_name = "FMM_Turbine_UTD"

# Check if sheet already exists
sheet_exists = any(sh.name == sheet_name for sh in wb.sheets)

if not sheet_exists:
    src = wb.sheets["FMM_Turbine_Template"]
    new_sheet = src.copy(after=wb.sheets[-1])
    new_sheet.name = sheet_name
    print(f"{sheet_name} created")
else:
    print(f"{sheet_name} already exists, skipping creation")

wb.save()
